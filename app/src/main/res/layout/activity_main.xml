<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:layout_width="436dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:background="#3E3488"
            android:text="Projeto Avaliativo - Programação de Dispositivos Móveis"
            android:textAlignment="center"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        tools:context=".MainActivity">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="238dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Calculadora de Descontos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"/>

        <EditText
            android:id="@+id/editValorCompra"
            android:layout_width="336dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:hint="Digite o valor da sua compra (R$)"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="193dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cornerRadius="8dp"
            android:text="Calcular Desconto" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>